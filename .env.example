# 服务端口（Nginx 反代到此端口）
PORT=3310
NODE_ENV=production

# 生产默认 127.0.0.1（仅本机 Nginx 可访问）；本地调试可设 0.0.0.0
# BIND_HOST=127.0.0.1

# 加密邮箱授权码用的密钥。生产环境（NODE_ENV=production）必须设为强随机串，否则进程拒绝启动；修改后所有已绑定邮箱需重新输入授权码
MAIL_SECRET=change-me-to-a-long-random-string

# HTTPS 下会话 Cookie 的 Secure 标记。生产（NODE_ENV=production）默认开启；仅排查时可设 COOKIE_SECURE=0
COOKIE_SECURE=1

# 会话：空闲天数 / 绝对最长天数（默认 14 / 30）
# SESSION_IDLE_DAYS=14
# SESSION_ABS_DAYS=30

# 数据目录（SQLite 数据库、定时发送的附件）
DATA_DIR=./data

# SQLite 定时备份（DATA_DIR/backups，在线 backup API，不打断 WAL）
# BACKUP_INTERVAL_HOURS=6
# BACKUP_KEEP=14

# 注册策略：首个注册的账号自动成为管理员；之后默认关闭注册，由管理员在「设置 → 团队成员」中开通
# 设置 SIGNUP_CODE 后，持有邀请码的人可自行注册；ALLOW_SIGNUP=1 则完全开放注册
# SIGNUP_CODE=
# ALLOW_SIGNUP=0

# 每个平台账号最多可绑定的邮箱数量
MAX_MAILBOXES_PER_USER=20

# AI（OpenAI 兼容接口，默认阿里百炼）
AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen3.8-max

# 可选：自建/指定企业邮件服务器。设置后，DEFAULT_MAIL_DOMAINS 中的域名（以及无法识别的域名）将默认连接这里
# DEFAULT_MAIL_NAME=ZITO 企业邮箱
# DEFAULT_MAIL_DOMAINS=zitoglobal.com
# DEFAULT_IMAP_HOST=mail.zitoglobal.com
# DEFAULT_IMAP_PORT=993
# DEFAULT_SMTP_HOST=mail.zitoglobal.com
# DEFAULT_SMTP_PORT=465
