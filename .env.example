# 服务端口（Nginx 反代到此端口）
PORT=3310
NODE_ENV=production

# 生产默认 127.0.0.1（仅本机 Nginx 可访问）；本地调试可设 0.0.0.0
# BIND_HOST=127.0.0.1

# 加密邮箱授权码用的密钥。生产环境（NODE_ENV=production）必须设为强随机串，否则进程拒绝启动；修改后所有已绑定邮箱需重新输入授权码
MAIL_SECRET=change-me-to-a-long-random-string

# HTTPS 下会话 Cookie 的 Secure 标记。生产（NODE_ENV=production）默认开启；仅排查时可设 COOKIE_SECURE=0
COOKIE_SECURE=1

# 会话：空闲天数 / 绝对最长天数（默认 14 / 30）
# SESSION_IDLE_DAYS=14
# SESSION_ABS_DAYS=30
# 登录成功后默认吊销同账号其它会话（多端互踢）；设为 0 可关闭
# SESSION_REVOKE_OTHERS_ON_LOGIN=1

# 健康检查：生产默认只返回 { ok }；设为 1 则始终返回详细字段
# HEALTH_DETAIL=0

# 数据目录（SQLite 数据库、定时发送的附件）
DATA_DIR=./data

# SQLite 定时备份（DATA_DIR/backups，在线 backup API，不打断 WAL；默认 AES 加密为 .db.enc）
# BACKUP_INTERVAL_HOURS=6
# BACKUP_KEEP=14
# 可选：与 MAIL_SECRET 分离的备份专用密钥；未设则用 MAIL_SECRET 派生
# BACKUP_SECRET=
# 仅应急：BACKUP_PLAIN=1 写明文 .db（不推荐）
# BACKUP_PLAIN=0

# 注册策略：首个注册的账号自动成为管理员；之后默认关闭注册，由管理员在「设置 → 团队成员」中开通
# 设置 SIGNUP_CODE 后，持有邀请码的人可自行注册；ALLOW_SIGNUP=1 则完全开放注册
# SIGNUP_CODE=
# ALLOW_SIGNUP=0

# 每个平台账号最多可绑定的邮箱数量
MAX_MAILBOXES_PER_USER=20

# AI（OpenAI 兼容接口，默认阿里百炼；按任务自动选模，不是一次打遍所有模型）
AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
# 强模型：写信/回复（也可写 AI_MODEL_STRONG）
AI_MODEL=qwen3.8-max
# 可选分层：未设时 mid/fast 回退到 AI_MODEL（当前 token-plan 实测仅 qwen3.8-max 可用时保持同模即可）
# AI_MODEL_MID=qwen3.8-max
# AI_MODEL_FAST=qwen3.8-max
# AI_MODEL_STRONG=qwen3.8-max

# 对外访问根地址（OAuth 回调拼装用，生产填 https://mail.zitoglobal.com）
# PUBLIC_BASE_URL=https://mail.zitoglobal.com

# Gmail OAuth（可选；未配置时绑定页仍用授权码）
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT=https://mail.zitoglobal.com/api/oauth/gmail/callback

# Microsoft 365 OAuth（可选）
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET=
# MS_OAUTH_TENANT=common
# MS_OAUTH_REDIRECT=https://mail.zitoglobal.com/api/oauth/microsoft/callback

# 可选：自建/指定企业邮件服务器。设置后，DEFAULT_MAIL_DOMAINS 中的域名（以及无法识别的域名）将默认连接这里
# DEFAULT_MAIL_NAME=ZITO 企业邮箱
# DEFAULT_MAIL_DOMAINS=zitoglobal.com
# DEFAULT_IMAP_HOST=mail.zitoglobal.com
# DEFAULT_IMAP_PORT=993
# DEFAULT_SMTP_HOST=mail.zitoglobal.com
# DEFAULT_SMTP_PORT=465
